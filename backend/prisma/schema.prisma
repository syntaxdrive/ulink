datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                        String    @id @default(uuid())
  email                     String    @unique
  name                      String?
  username                  String?   @unique
  role                      String    @default("Student")
  password_hash             String?
  university                String?
  avatar_url                String?
  background_image_url      String?
  headline                  String?
  location                  String?
  about                     String?
  skills                    String[]  @default([])
  website                   String?
  website_url               String?
  github_url                String?
  linkedin_url              String?
  instagram_url             String?
  twitter_url               String?
  facebook_url              String?
  youtube_url               String?
  tiktok_url                String?
  whatsapp_url              String?
  industry                  String?
  resume_url                String?
  points                    Int       @default(0)
  is_verified               Boolean   @default(false)
  is_admin                  Boolean   @default(false)
  is_test_user              Boolean   @default(false)
  followers_count           Int       @default(0)
  following_count           Int       @default(0)
  connections_count         Int       @default(0)
  expected_graduation_year  String?
  graduation_year           String?
  department                String?
  study_year                String?
  referral_code             String?
  referred_by               String?
  store_name                String?
  store_description         String?
  store_banner_url          String?
  store_slug                String?
  last_seen                 DateTime?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt

  // Relationships
  posts                     Post[]                   @relation("UserPosts")
  comments                  Comment[]                @relation("UserComments")
  likes                     Like[]                   @relation("UserLikes")
  messagesSent              Message[]                @relation("SentMessages")
  messagesRecv              Message[]                @relation("ReceivedMessages")
  connectionsReq            Connection[]             @relation("Requester")
  connectionsRec            Connection[]             @relation("Recipient")
  followers                 Follow[]                 @relation("Followers")
  following                 Follow[]                 @relation("Following")
  coursesAuthored           Course[]                 @relation("CourseAuthor")
  courseDocuments           CourseDocument[]         @relation("UploaderDocs")
  podcastsCreated           Podcast[]                @relation("PodcastCreator")
  podcastFollows            PodcastFollow[]          @relation("UserPodcastFollows")
  studyRoomsCreated         StudyRoom[]              @relation("RoomHost")
  studyRoomParticipants     StudyRoomParticipant[]   @relation("RoomParticipants")
  notifications             Notification[]           @relation("UserNotifications")
  communitiesCreated        Community[]              @relation("CommunityCreator")
  communityMemberships      CommunityMember[]        @relation("UserCommunityMembers")
  jobsCreated               Job[]                    @relation("JobCreator")

  @@index([email])
  @@index([username])
  @@index([university])
  @@index([points(sort: Desc)])
}

model Connection {
  id           String   @id @default(uuid())
  requester_id String
  recipient_id String
  status       String   @default("pending")
  created_at   DateTime @default(now())

  requester    User     @relation("Requester", fields: [requester_id], references: [id], onDelete: Cascade)
  recipient    User     @relation("Recipient", fields: [recipient_id], references: [id], onDelete: Cascade)

  @@unique([requester_id, recipient_id])
  @@index([recipient_id, status])
}

model Follow {
  id           String   @id @default(uuid())
  follower_id  String
  following_id String
  created_at   DateTime @default(now())

  follower     User     @relation("Followers", fields: [follower_id], references: [id], onDelete: Cascade)
  following    User     @relation("Following", fields: [following_id], references: [id], onDelete: Cascade)

  @@unique([follower_id, following_id])
  @@index([following_id])
  @@index([follower_id])
}

model Post {
  id               String      @id @default(uuid())
  author_id        String
  content          String?
  image_url        String?
  image_urls       String[]    @default([])
  video_url        String?
  community_id     String?
  is_repost        Boolean     @default(false)
  original_post_id String?
  repost_comment   String?
  poll_options     String[]    @default([])
  poll_counts      Int[]       @default([])
  shared_to_feed   Boolean     @default(true)
  likes_count      Int         @default(0)
  comments_count   Int         @default(0)
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  author           User        @relation("UserPosts", fields: [author_id], references: [id], onDelete: Cascade)
  community        Community?  @relation(fields: [community_id], references: [id], onDelete: SetNull)
  likes            Like[]
  comments         Comment[]

  @@index([author_id, created_at(sort: Desc)])
  @@index([created_at(sort: Desc)])
}

model Like {
  id         String   @id @default(uuid())
  post_id    String
  user_id    String
  created_at DateTime @default(now())

  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user       User     @relation("UserLikes", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([post_id, user_id])
  @@index([user_id])
}

model Comment {
  id          String   @id @default(uuid())
  post_id     String
  author_id   String
  content     String
  sticker_url String?
  type        String   @default("text")
  parent_id   String?
  created_at  DateTime @default(now())

  post        Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  author      User     @relation("UserComments", fields: [author_id], references: [id], onDelete: Cascade)

  @@index([post_id, created_at(sort: Asc)])
}

model Message {
  id           String    @id @default(uuid())
  sender_id    String
  recipient_id String
  content      String?
  image_url    String?
  audio_url    String?
  is_deleted   Boolean   @default(false)
  read_at      DateTime?
  created_at   DateTime  @default(now())

  sender       User      @relation("SentMessages", fields: [sender_id], references: [id], onDelete: Cascade)
  recipient    User      @relation("ReceivedMessages", fields: [recipient_id], references: [id], onDelete: Cascade)

  @@index([sender_id, recipient_id, created_at(sort: Desc)])
  @@index([recipient_id, read_at])
}

model Course {
  id                String           @id @default(uuid())
  author_id         String
  title             String
  description       String?
  category          String
  level             String           @default("All Levels")
  youtube_url       String?
  video_id          String?
  thumbnail_url     String?
  duration          String?
  tags              String[]         @default([])
  content_type      String           @default("video")
  likes_count       Int              @default(0)
  enrollments_count Int              @default(0)
  views_count       Int              @default(0)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  author            User             @relation("CourseAuthor", fields: [author_id], references: [id], onDelete: Cascade)
  documents         CourseDocument[]

  @@index([category])
  @@index([created_at(sort: Desc)])
}

model CourseDocument {
  id              String   @id @default(uuid())
  course_id       String
  uploader_id     String
  name            String
  storage_path    String
  public_url      String
  file_type       String
  file_size       Int
  downloads_count Int      @default(0)
  created_at      DateTime @default(now())

  course          Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  uploader        User     @relation("UploaderDocs", fields: [uploader_id], references: [id], onDelete: Cascade)

  @@index([course_id])
}

model Podcast {
  id               String           @id @default(uuid())
  creator_id       String
  title            String
  description      String
  category         String
  cover_url        String?
  status           String           @default("approved")
  rejection_reason String?
  followers_count  Int              @default(0)
  episodes_count   Int              @default(0)
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt

  creator          User             @relation("PodcastCreator", fields: [creator_id], references: [id], onDelete: Cascade)
  episodes         PodcastEpisode[]
  follows          PodcastFollow[]

  @@index([creator_id])
  @@index([category])
}

model PodcastEpisode {
  id               String   @id @default(uuid())
  podcast_id       String
  title            String
  description      String?
  audio_url        String
  cover_url        String?
  duration_seconds Int      @default(0)
  episode_number   Int?
  plays_count      Int      @default(0)
  is_published     Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  podcast          Podcast  @relation(fields: [podcast_id], references: [id], onDelete: Cascade)

  @@index([podcast_id])
}

model PodcastFollow {
  podcast_id String
  user_id    String
  created_at DateTime @default(now())

  podcast    Podcast  @relation(fields: [podcast_id], references: [id], onDelete: Cascade)
  user       User     @relation("UserPodcastFollows", fields: [user_id], references: [id], onDelete: Cascade)

  @@id([podcast_id, user_id])
}

model StudyRoom {
  id                    String                 @id @default(uuid())
  creator_id            String
  name                  String
  subject               String?
  description           String?
  timer_minutes         Int                    @default(25)
  timer_started_at      DateTime?
  timer_paused_at       DateTime?
  timer_elapsed_seconds Int                    @default(0)
  is_private            Boolean                @default(false)
  allow_drawing         Boolean                @default(true)
  is_active             Boolean                @default(true)
  created_at            DateTime               @default(now())

  creator               User                   @relation("RoomHost", fields: [creator_id], references: [id], onDelete: Cascade)
  participants          StudyRoomParticipant[]

  @@index([is_active, created_at(sort: Desc)])
}

model StudyRoomParticipant {
  id        String    @id @default(uuid())
  room_id   String
  user_id   String
  status    String    @default("Here")
  joined_at DateTime  @default(now())

  room      StudyRoom @relation(fields: [room_id], references: [id], onDelete: Cascade)
  user      User      @relation("RoomParticipants", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([room_id, user_id])
}

model Community {
  id              String            @id @default(uuid())
  name            String
  slug            String            @unique
  description     String?
  icon_url        String?
  cover_image_url String?
  privacy         String            @default("public")
  created_by      String
  members_count   Int               @default(1)
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt

  creator         User              @relation("CommunityCreator", fields: [created_by], references: [id], onDelete: Cascade)
  posts           Post[]
  members         CommunityMember[]

  @@index([slug])
}

model CommunityMember {
  id           String    @id @default(uuid())
  community_id String
  user_id      String
  role         String    @default("member") // owner, admin, moderator, member
  status       String    @default("active")
  joined_at    DateTime  @default(now())

  community    Community @relation(fields: [community_id], references: [id], onDelete: Cascade)
  user         User      @relation("UserCommunityMembers", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([community_id, user_id])
}

model Job {
  id               String   @id @default(uuid())
  title            String
  company          String
  type             String   @default("Internship")
  description      String?
  application_link String?
  location         String?
  salary_range     String?
  deadline         DateTime?
  logo_url         String?
  creator_id       String
  status           String   @default("active")
  created_at       DateTime @default(now())

  creator          User     @relation("JobCreator", fields: [creator_id], references: [id], onDelete: Cascade)

  @@index([creator_id])
  @@index([status])
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  type       String
  title      String
  content    String
  action_url String?
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  user       User     @relation("UserNotifications", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
}
