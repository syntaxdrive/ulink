# UniLink NestJS Backend — Environment Variables
# Copy this to .env and fill in your values

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://unilink:YOUR_DB_PASSWORD@localhost:5432/unilink

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-in-production
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# ─── Cloudflare R2 Storage ─────────────────────────────────────────────────────
# Get these from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=unilink-media
# Enable public access on the bucket, then set this to the public URL
R2_PUBLIC_URL=https://pub.your-r2-domain.com

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ─── Supabase (KEEP — used as emergency fallback from mobile) ──────────────────
# Do not delete these. The mobile app falls back to Supabase if NestJS is unreachable.
SUPABASE_URL=https://rwtdjpwsxtwfeecseugg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
